                          "children": [
                            { "name": "Cache", "path": "C:\\Local\\Google\\Chrome\\User Data\\Default\\Cache", "attrs": 16, "mtimeMs": 0,
                              "files": [ { "name": "c1.bin", "size": 50, "mtimeMs": 0, "attrs": 0 } ] }
                          ] },
                        { "name": "Profile 2", "path": "C:\\Local\\Google\\Chrome\\User Data\\Profile 2", "attrs": 16, "mtimeMs": 0,
                          "children": [
