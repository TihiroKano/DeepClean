        "riskLevel": "safe", "cleanStrategy": "delete-all", "recoverable": true },
      { "id": "r-npm", "name": "npm 缓存", "category": "dev-cache", "description": "d",
        "paths": ["%LOCALAPPDATA%\\npm-cache"],
        "scanner": { "filePatterns": [], "olderThanDays": null, "recursive": true },
        "riskLevel": "caution", "cleanStrategy": "delete-all", "recoverable": true },
      { "id": "r-risk", "name": "高风险项", "category": "dev-cache", "description": "d",
        "paths": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache"],
        "scanner": { "filePatterns": [], "olderThanDays": null, "recursive": true },
        "riskLevel": "high", "cleanStrategy": "delete-all", "recoverable": false },
      { "id": "r-bin", "name": "回收站", "category": "recycle-bin", "description": "d",
        "paths": ["%SYSTEMDRIVE%\\$Recycle.Bin"],
        "scanner": { "filePatterns": [], "olderThanDays": null, "recursive": true },
        "riskLevel": "forbidden", "cleanStrategy": "manual-only", "recoverable": true },
      { "id": "r-dev", "name": "HF 缓存", "category": "dev-cache", "description": "d",
        "paths": ["%USERPROFILE%\\.cache\\huggingface"],
        "scanner": { "filePatterns": [], "olderThanDays": null, "recursive": true },
        "riskLevel": "caution", "cleanStrategy": "delete-all", "recoverable": true,
        "requiresDetector": "huggingface", "excludedFromDefaultSelection": true }
    ],
    "declared-rejected": [
      { "id": "d-temp", "name": "临时文件（这条是有效的）", "category": "temp", "description": "d",
        "paths": ["%TEMP%"],
        "scanner": { "filePatterns": [], "olderThanDays": null, "recursive": true },
        "riskLevel": "safe", "cleanStrategy": "delete-all", "recoverable": true },
