    "WINDIR": "C:\\Windows",
    "TEMP": "C:\\Temp",
    "LOCALAPPDATA": "C:\\Local",
    "APPDATA": "C:\\Users\\Kano\\AppData\\Roaming",
    "PROGRAMDATA": "C:\\ProgramData"
  },
